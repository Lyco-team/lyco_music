{
  "name": "lyco_music",
  "version": "0.2.64",
  "private": true,
  "description": "Lyco Music 网易云音乐风格 UI 重制版 — 共享内核 Monorepo",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --ext .ts,.vue --max-warnings 0",
    "test": "vitest run",
    "test:mobile": "jest --config apps/mobile/jest.config.js",
    "tokens:build": "pnpm --filter @lxmn/tokens build",
    "bump": "node scripts/bump-version.mjs",
    "probe:download": "electron scripts/probe-download.cjs",
    "pwa:build": "node scripts/build-lyco-pwa.mjs",
    "pwa:check": "python3 scripts/check-lyco-pwa.py .",
    "test:ui-parity": "vitest run tests/desktop-ui-parity.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.21.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
